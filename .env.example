# Copy to .env to override. Everything here is optional.
# Roles, daily cap and the Google Sheet link are set in the dashboard, not here.

# Where the database, logs and browser session are kept.
# Default: %LOCALAPPDATA%\NaukriJobAutomation (kept outside OneDrive on purpose).
# NJA_DATA_DIR=C:\Users\you\AppData\Local\NaukriJobAutomation

# Largest CV file accepted, in MB.
# NJA_MAX_CV_SIZE_MB=5
